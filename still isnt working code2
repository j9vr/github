# ---------- ROUTES ----------
@app.route("/")
def home():
    return home_html

@app.route("/about")
def about():
    return about_html

@app.route("/video")
def video():
    return video_html

@app.route("/upload", methods=["GET", "POST"])
def upload():
    if request.method == "POST":
        file = request.files["file"]
        if file:
            file.save(os.path.join("uploads", file.filename))
            return upload_done_html
    return upload_html

# ---------- View uploaded files ----------
@app.route("/uploads")
def list_uploads():
    files = os.listdir("uploads")
    file_links = ""
    for f in files:
        file_links += f"<li><a href='/uploads/{f}'>{f}</a></li>"
    return f"""
    <h1>Uploaded Files</h1>
    <ul>
        {file_links if file_links else '<li>No files uploaded yet.</li>'}
    </ul>
    <a href='/'><button>Back</button></a>
    """

@app.route("/uploads/<filename>")
def uploaded_file(filename):
    return send_from_directory("uploads", filename)

# ---------- RUN APP ----------
if __name__ == "__main__":
    app.run(debug=True)

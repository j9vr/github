from flask import Flask

app = Flask(__name__)

# ---------- HTML TEMPLATES INSIDE PYTHON ----------
home_html = """
<!DOCTYPE html>
<html>
<head>
    <title>My Python Web</title>
    <style>
        body { font-family: Arial; background: #111; color: white; text-align: center; }
        a { color: #00ff88; font-size: 20px; text-decoration: none; margin: 10px; display: inline-block; }
        .box { margin-top: 100px; }
        button {
            background: #00ff88;
            border: none;
            padding: 10px 20px;
            font-size: 20px;
            border-radius: 8px;
            cursor: pointer;
        }
        button:hover { background: #00cc66; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Welcome to My Python Website</h1>
        <p>This is a full website inside one Python file.</p>
        
        <a href="/about"><button>About Page</button></a>
        <a href="/video"><button>Video Page</button></a>
    </div>
</body>
</html>
"""

about_html = """
<!DOCTYPE html>
<html>
<head>
    <title>About</title>
    <style>
        body { font-family: Arial; background: #222; color: white; text-align: center; }
        a { color: #00ff88; font-size: 20px; text-decoration: none; }
    </style>
</head>
<body>
    <h1>About This Web</h1>
    <p>This web was created using Flask in one Python file.</p>
    <a href="/">Go Back</a>
</body>
</html>
"""

video_html = """
<!DOCTYPE html>
<html>
<head>
    <title>Video Page</title>
    <style>
        body { font-family: Arial; background: #000; color: white; text-align: center; }
        a { color: #00ff88; }
        iframe { border-radius: 12px; margin-top: 20px; }
    </style>
</head>
<body>
    <h1>Video Example</h1>
    <p>You can embed videos here.</p>

    <iframe width="560" height="315"
        src="https://www.youtube.com/embed/dQw4w9WgXcQ"
        allowfullscreen>
    </iframe>

    <br><br>
    <a href="/">Go Back</a>
</body>
</html>
"""

# ---------- ROUTES ----------
@app.route("/")
def home():
    return home_html

@app.route("/about")
def about():
    return about_html

@app.route("/video")
def video():
    return video_html

# ---------- RUN APP ----------
if __name__ == "__main__":
    app.run(debug=True)
